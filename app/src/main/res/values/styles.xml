<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#176C53</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F6F8F4</item>
        <item name="android:navigationBarColor">#F6F8F4</item>
        <item name="android:windowBackground">#F6F8F4</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="TideDarkTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#B0D9AD</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#0D1412</item><item name="android:navigationBarColor">#0D1412</item><item name="android:windowBackground">#0D1412</item>
        <item name="android:forceDarkAllowed">false</item><item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
